{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    {
      "source": "/((?!api/|assets/|images/|uploads/|favicon\\.ico|.*\\.(?:js|css|png|jpg|jpeg|webp|gif|svg|ico|woff2?|json)).*)",
      "destination": "/index.html"
    }
  ]
}
